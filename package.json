{
    "name": "rfid-web-app",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:development": "vite build --mode development",
        "build:staging": "vite build --mode staging",
        "build:production": "vite build --mode production",
        "type-check": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "test:ci": "npm run type-check && npm run test:unit && npm run build",
        "test:regression": "node tests/regression/runner.js",
        "test:e2e": "node tests/e2e/runner.js",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "danger:lint-report": "NODE_ENV=production eslint . --format checkstyle --output-file reports/lint-results.xml --quiet || true",
        "danger:ci": "danger ci --failOnErrors",
        "prettier": "prettier --write .",
        "lint": "eslint . --fix",
        "prepare": "husky"
    },
    "dependencies": {
        "@vee-validate/zod": "^4.15.1",
        "axios": "^1.7.2",
        "flowbite": "^4.0.2",
        "lucide-vue-next": "^0.564.0",
        "pinia": "^2.3.0",
        "vee-validate": "^4.15.1",
        "vue": "^3.4.0",
        "vue-router": "^4.2.2",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.0.1",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.27.0",
        "@storybook/addon-a11y": "^10.2.10",
        "@storybook/addon-docs": "^10.2.10",
        "@storybook/addon-onboarding": "^10.2.10",
        "@storybook/addon-vitest": "^10.2.10",
        "@storybook/vue3-vite": "^10.2.10",
        "@types/node": "^20.1.0",
        "@types/selenium-webdriver": "^4.35.6",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@vitejs/plugin-vue": "^5.1.0",
        "@vitest/browser-playwright": "^4.0.18",
        "@vitest/coverage-v8": "^4.0.18",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "autoprefixer": "^10.4.15",
        "danger": "10.6.0",
        "danger-plugin-istanbul-coverage": "^1.6.2",
        "danger-plugin-lint-report": "^1.8.1",
        "danger-plugin-pull-request": "^1.1.4",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-formatter-checkstyle": "^8.40.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-vue": "^10.1.0",
        "globals": "^16.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.0.0",
        "playwright": "^1.58.2",
        "postcss": "^8.4.24",
        "prettier": "^3.5.3",
        "selenium-webdriver": "^4.44.0",
        "storybook": "^10.2.10",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.2.2",
        "vite": "^5.0.0",
        "vitest": "^4.0.18",
        "vue-eslint-parser": "^10.1.3",
        "vue-tsc": "^3.3.3"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "npm run lint"
        ]
    }
}
