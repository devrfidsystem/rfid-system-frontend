# Versioning and metadata
.git
.github
.gitignore
.dockerignore
.gitlab-ci.yml

# Build dependencies
# dist must be ignored: a stale committed dist/ would be copied into the
# build context and can shadow the freshly built output.
dist
node_modules
coverage
storybook-static

# Locally generated by newer pnpm. If it reaches the build context, pnpm
# treats the directory as a workspace root and fails with
# "packages field missing or empty".
pnpm-workspace.yaml

# Environment (contains sensitive data)
.env
.env.*
!.env.example

# Not needed in the image
Dockerfile
docker-compose.yml
npm-debug.log
*.md
!README.md
tests
.storybook
docs
