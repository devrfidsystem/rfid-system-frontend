# Application
VITE_APP_TITLE="Alir Smart System"

# Backend API — ORIGIN ONLY, no path.
# The API client appends "/api/v1" itself (see src/lib/api/client.ts),
# so including it here produces /api/v1/api/v1/... and every call 404s.
VITE_API_BASE_URL=https://api-alir.niflheim.web.id

# Supabase — must be the SAME project the backend validates against,
# or the backend will reject every token this app issues.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
